---
import Layout from '../../layouts/Layout.astro';
import EstimateForm from '../../components/EstimateForm.astro';

const areas = ['Ocala', 'Silver Springs', 'Belleview', 'Summerfield', 'Dunnellon', 'Lady Lake', 'Citra'];
---

<Layout
  title="Contact Ocala Level Pros | Free Estimates, (352) 247-3105"
  description="Call (352) 247-3105 or request a free written estimate for mobile home leveling, tie-downs, vapor barrier, or skirting in Ocala and Marion County, FL."
  canonical="https://ocalalevelpros.com/contact/"
>
<Fragment slot="head">
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://ocalalevelpros.com/"}, {"@type": "ListItem", "position": 2, "name": "Contact", "item": "https://ocalalevelpros.com/contact/"}]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "ContactPage", "url": "https://ocalalevelpros.com/contact/", "mainEntity": {"@id": "https://ocalalevelpros.com/#organization"}}</script>
</Fragment>

<section style="background:linear-gradient(135deg, #175445 0%, #1F6D5A 65%, #175445 100%);padding:64px 24px;">
  <div style="max-width:820px;margin:0 auto;text-align:center;">
    <span style="display:inline-block;margin-bottom:12px;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;background:rgba(240,168,96,0.18);color:#F0A860;border:1px solid rgba(240,168,96,0.3);">Contact</span>
    <h1 style="font-family:'Poppins',sans-serif;font-weight:800;color:#fff;line-height:1.1;font-size:clamp(28px,4.2vw,46px);margin:0 0 16px;">Talk to Someone Who Works Under These Homes</h1>
    <p style="font-size:18px;line-height:1.7;color:rgba(255,255,255,0.86);max-width:600px;margin:0 auto 28px;">Free written estimates across Marion, Sumter, and Citrus counties. Our line is answered 24/7 when a closing or insurance deadline can't wait.</p>
    <a href="tel:+13522473105" class="btn-cream">Call Now &mdash; (352) 247-3105</a>
  </div>
</section>

<section style="padding:56px 24px 24px;">
  <div class="c-grid" style="max-width:1060px;margin:0 auto;display:grid;grid-template-columns:0.85fr 1.15fr;gap:52px;">
    <div>
      <span class="kicker">Reach Us</span>
      <h2 class="section-heading" style="font-size:clamp(22px,3vw,30px);margin:0 0 24px;">Details</h2>

      <p style="font-family:'Poppins',sans-serif;font-size:13px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#16332C;margin:0 0 6px;">Phone</p>
      <p style="font-size:16px;line-height:1.7;color:#555;margin:0 0 20px;"><a href="tel:+13522473105" style="color:#1F6D5A;font-weight:600;text-decoration:none;">(352) 247-3105</a><br><span style="font-size:14px;color:#8B968E;">Fastest way to reach us. Texts welcome.</span></p>

      <p style="font-family:'Poppins',sans-serif;font-size:13px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#16332C;margin:0 0 6px;">Email</p>
      <p style="font-size:16px;line-height:1.7;color:#555;margin:0 0 20px;"><a href="mailto:info@ocalalevelpros.com" style="color:#1F6D5A;font-weight:600;text-decoration:none;">info@ocalalevelpros.com</a><br><span style="font-size:14px;color:#8B968E;">Good for sending inspection reports or photos.</span></p>

      <p style="font-family:'Poppins',sans-serif;font-size:13px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#16332C;margin:0 0 6px;">Hours</p>
      <p style="font-size:16px;line-height:1.7;color:#555;margin:0 0 20px;">Monday&ndash;Saturday, 7am&ndash;6pm<br><span style="font-size:14px;color:#8B968E;">24/7 emergency line for closings and insurance deadlines. After-hours calls carry a disclosed trip fee.</span></p>

      <p style="font-family:'Poppins',sans-serif;font-size:13px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#16332C;margin:0 0 6px;">Service Area</p>
      <p style="font-size:16px;line-height:1.7;color:#555;margin:0 0 10px;">We come to you. Ocala Level Pros is a mobile service covering Marion, Sumter, and Citrus counties:</p>
      <ul style="list-style:none;padding:0;margin:0 0 20px;display:flex;flex-wrap:wrap;gap:8px;">
        {areas.map(a => (
          <li style="font-size:14px;font-weight:600;color:#1F6D5A;background:#F5F0E4;border:1px solid #E4DCC8;border-radius:999px;padding:5px 14px;">{a}</li>
        ))}
      </ul>
      <p style="font-size:14px;line-height:1.7;color:#8B968E;margin:0;">Not sure you're in range? Call and we'll tell you straight.</p>
    </div>

    <div>
      <EstimateForm heading="Request a Free Estimate" service="Contact Page" />
    </div>
  </div>
</section>

<section style="padding:32px 24px 72px;">
  <div style="max-width:1060px;margin:0 auto;">
    <p style="font-size:15px;line-height:1.8;color:#555;margin:0;">Looking for pricing before you call? Our <a href="/mobile-home-leveling-cost/" style="color:#1F6D5A;font-weight:600;text-decoration:none;">mobile home leveling cost guide</a> lists real 2026 ranges for Marion County, and the <a href="/blog/" style="color:#1F6D5A;font-weight:600;text-decoration:none;">blog</a> covers tie-down requirements, 4-point inspections, and what to check under your home.</p>
  </div>
</section>
<style>
  @media (max-width: 900px) { .c-grid { grid-template-columns: 1fr !important; gap: 36px !important; } }
</style>
</Layout>
