<!-- SERVICE CARDS -->
<section style="padding:0 24px 80px;background:#F5F0E4;">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="svc-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      <a href="/mobile-home-leveling-ocala/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #E4DCC8;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(22,51,44,0.06);">
        <h3 style="font-family:'Poppins',sans-serif;font-size:20px;font-weight:800;color:#16332C;margin:0 0 10px;">Mobile Home Leveling</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">We check every pier with a water level, then jack and shim your home back to spec. Doors close, floors settle down, and you get the readings in writing.</p>
        <span style="font-size:13px;font-weight:700;color:#E07B1F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/mobile-home-tie-downs-ocala/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #E4DCC8;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(22,51,44,0.06);">
        <h3 style="font-family:'Poppins',sans-serif;font-size:20px;font-weight:800;color:#16332C;margin:0 0 10px;">Tie-Downs & Anchors</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Rusted straps and loose anchors are the number one reason 4-point inspections fail around here. We replace and tension tie-downs to Florida wind zone requirements and document everything for your insurer.</p>
        <span style="font-size:13px;font-weight:700;color:#E07B1F;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
